PORT=3000

# Secreto compartido: debe ser IDÉNTICO al que pongas en la app (lib/sync/uploadService.ts)
API_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ID de la carpeta de Drive compartida con el correo de la cuenta de servicio
# (se obtiene de la URL de la carpeta: drive.google.com/drive/folders/ESTE_ID)
DRIVE_FOLDER_ID=

# El JSON completo de la cuenta de servicio, en una sola línea (para producción/hosting).
# Si lo dejas vacío, el backend intentará leer ./service-account.json en su lugar (solo dev local).
GOOGLE_SERVICE_ACCOUNT_JSON=
